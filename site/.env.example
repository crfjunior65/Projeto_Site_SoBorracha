# ===================================================================
# Exemplo de configuração de ambiente - Só Borracha Ltda
# Copie este arquivo para ".env" e preencha os valores reais.
#   cp .env.example .env
# NUNCA coloque a senha real neste .env.example (ele É versionado).
# ===================================================================

# --- SMTP (envio de e-mails do formulário de contato) ---
SMTP_HOST=mail.soborracha.com.br
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=webmaster@soborracha.com.br
SMTP_PASSWORD=coloque_a_senha_aqui
SMTP_FROM_EMAIL=webmaster@soborracha.com.br
SMTP_FROM_NAME=Só Borracha Ltda
SMTP_DESTINATION=ronaldo@soborracha.com.br
SMTP_TIMEOUT=30
