<?php
require_once __DIR__ . '/includes/PartnerStore.php';

$pageTitle = "Nossos Parceiros - Só Borracha "" | Rede de Distribuidores e Revendedores";
$pageDescription = "Conheça a rede de parceiros da Só Borracha: distribuidores, revendedores, lojas e oficinas credenciadas. Faça parte da nossa rede e amplie seus negócios.";

$store = new PartnerStore();
$parceiros = $store->all(true); // apenas ativos, destaques primeiro

// Tipos presentes (para os filtros)
$tiposPresentes = [];
foreach ($parceiros as $p) {
    $t = $p['tipo'] ?? '';
    if ($t && !in_array($t, $tiposPresentes)) {
        $tiposPresentes[] = $t;
    }
}
